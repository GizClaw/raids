{
  "schema": "raids.raid/v1alpha1",
  "id": "story-water-margin",
  "category": "story",
  "title": {
    "zh-CN": "水浒群英",
    "en": "Heroes of the Water Margin"
  },
  "summary": {
    "zh-CN": "通过水浒人物故事讨论勇气、规则、友情与责任。",
    "en": "Use Water Margin characters to discuss courage, rules, friendship, and responsibility."
  },
  "rating": {
    "age": "9+",
    "scheme": "raids-age-v1",
    "content": [
      "historical-conflict"
    ]
  },
  "tags": [
    "chinese-classic",
    "heroes"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-water-margin",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-water-margin.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-water-margin",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-water-margin.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-water-margin.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-water-margin.lin-chong": {
            "role": "lin-chong",
            "language": "zh-CN",
            "description": "林冲 character voice"
          },
          "flowcraft-story-water-margin.lu-zhishen": {
            "role": "lu-zhishen",
            "language": "zh-CN",
            "description": "鲁智深 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-water-margin-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-water-margin-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "朋友受屈",
        "冲动与规则",
        "证据转折",
        "担当收束"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-water-margin/eino.giztest.yaml",
