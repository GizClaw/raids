{
  "schema": "raids.raid/v1alpha1",
  "id": "story-twenty-thousand-leagues",
  "category": "story",
  "title": {
    "zh-CN": "海底两万里",
    "en": "Twenty Thousand Leagues Under the Seas"
  },
  "summary": {
    "zh-CN": "乘坐想象中的潜艇探索海洋、科技与未知生物。",
    "en": "Explore oceans, technology, and unknown creatures aboard an imagined submarine."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "ocean",
    "science",
    "verne",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-twenty-thousand-leagues",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-twenty-thousand-leagues.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-twenty-thousand-leagues",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-twenty-thousand-leagues.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-twenty-thousand-leagues.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-twenty-thousand-leagues.nemo": {
            "role": "nemo",
            "language": "zh-CN",
            "description": "尼摩 character voice"
          },
          "flowcraft-story-twenty-thousand-leagues.aronnax": {
            "role": "aronnax",
            "language": "zh-CN",
            "description": "阿龙纳斯 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-twenty-thousand-leagues-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-twenty-thousand-leagues-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "发光巨影",
        "深海档案",
        "潜艇危机",
        "海洋约定"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-twenty-thousand-leagues/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-twenty-thousand-leagues/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-twenty-thousand-leagues/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-twenty-thousand-leagues/eino.realtime.giztest.yaml",
      "implementation": "eino",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-twenty-thousand-leagues/flowcraft.realtime.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    }
  ]
}
