{
  "schema": "raids.raid/v1alpha1",
  "id": "guess-inventions-discoveries",
  "category": "guess",
  "region": "global",
  "title": {
    "zh-CN": "猜猜发明与发现",
    "en": "Guess the Invention or Discovery"
  },
  "summary": {
    "zh-CN": "主持人心里藏着一项发明或发现，孩子用是非题来猜，猜中就升一关，从“发明小萌新”一路挑战到“文明解码者”。",
    "en": "The host hides a famous invention or discovery; the child guesses with yes-or-no questions and levels up from Invention Rookie to Civilization Decoder."
  },
  "rating": {
    "age": [
      "preschool",
      "child",
      "teen"
    ],
    "scheme": "raids-age-v2",
    "content": []
  },
  "tags": [
    "guess",
    "inventions",
    "discoveries",
    "science-history",
    "yes-no",
    "levels"
  ],
  "language": [
    "zh-CN",
    "en"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-guess-inventions-discoveries",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "parameters": {
        "models": {
          "eino-guess-inventions-discoveries.model": {
            "kind": "llm",
            "role": "host",
            "description": "Chat model that speaks every host turn from the nameless puzzle card; needs streaming Chinese and English output"
          }
        },
        "voices": {
          "eino-guess-inventions-discoveries.host": {
            "role": "host",
            "language": "zh-CN",
            "description": "Quiz host voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "guess-inventions-discoveries-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "guess-inventions-discoveries-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 10,
      "checkpoints": [
        "opening",
        "yes-answer",
        "ask-answer",
        "big-hint",
        "no-answer",
        "win",
        "next-round",
        "english",
        "give-up",
        "resume"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/smoke/guess-inventions-discoveries.eino.giztest.yaml",
      "tier": "smoke",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/quality/guess-inventions-discoveries.eino.giztest.yaml",
      "tier": "quality",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/soak/guess-inventions-discoveries.eino.giztest.yaml",
      "tier": "soak",
      "implementations": [
        "eino"
      ]
    }
  ]
}
