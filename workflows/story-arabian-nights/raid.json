{
  "schema": "raids.raid/v1alpha1",
  "id": "story-arabian-nights",
  "category": "story",
  "title": {
    "zh-CN": "一千零一夜",
    "en": "Arabian Nights"
  },
  "summary": {
    "zh-CN": "进入充满旅行、谜题和智慧选择的一千零一夜。",
    "en": "Enter an Arabian Nights journey filled with travel, riddles, and wise choices."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "folktale",
    "adventure",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-arabian-nights",
      "driver": "eino",
      "input": [
        "text"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-arabian-nights.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-arabian-nights",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-arabian-nights.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-arabian-nights.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-arabian-nights-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-arabian-nights-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 7,
      "checkpoints": [
        "opening",
        "english-opening",
        "continue-choice",
        "fact-boundary",
        "safety-boundary",
        "memory-store",
        "memory-recall"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-arabian-nights/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    },
    {
      "file": "tests/giztest/story-arabian-nights/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    }
  ]
}
