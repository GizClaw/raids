{
  "schema": "raids.raid/v1alpha1",
  "id": "figure-da-vinci",
  "category": "figure",
  "title": {
    "zh-CN": "达芬奇的一生",
    "en": "A Life with Leonardo da Vinci"
  },
  "summary": {
    "zh-CN": "由达芬奇本人带孩子走完他的一生，从米兰的笔记本走到法国的晚年，并分清史实、传说与改编。",
    "en": "Walk through the life of Leonardo da Vinci with the artist himself, telling history, legend, and adaptation apart."
  },
