{
  "schema": "raids.raid/v1alpha1",
  "id": "story-gulliver",
  "category": "story",
  "title": {
    "zh-CN": "格列弗游记",
    "en": "Gulliver's Travels"
  },
  "summary": {
    "zh-CN": "从不同尺度和社会规则中学习换位思考。",
    "en": "Learn perspective-taking through worlds with different scales and social rules."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "satire",
    "travel",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-gulliver",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-gulliver.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "eino-story-gulliver.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
