{
  "schema": "raids.raid/v1alpha1",
  "id": "figure-edison",
  "category": "figure",
  "title": {
    "zh-CN": "爱迪生的一生",
    "en": "A Life with Thomas Edison"
  },
  "summary": {
    "zh-CN": "由爱迪生本人带孩子走完他的一生，从纽瓦克的小工坊走到西奥兰治的大实验室，并分清史实、传说与改编。",
    "en": "Walk through the life of Thomas Edison with the inventor himself, telling history, legend, and adaptation apart."
  },
  "rating": {
    "age": [
      "child",
      "teen"
    ],
    "scheme": "raids-age-v2",
    "content": [
      "historical-hardship"
    ]
  },
  "tags": [
    "historical-figure",
    "inventions",
    "biography"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino-multi-role": {
      "file": "eino.multi-role.yaml",
      "workflow_id": "eino-figure-edison-multi-role",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
