{
  "schema": "raids.raid/v1alpha1",
  "id": "chat-assistant",
  "category": "assistant",
  "title": {
    "zh-CN": "聊天助手",
    "en": "Chat Assistant"
  },
  "summary": {},
  "rating": {
    "age": [
      "preschool",
      "child",
      "teen",
      "adult",
      "senior"
    ],
    "scheme": "raids-age-v2",
    "content": []
  },
  "tags": [
    "assistant",
    "memory",
    "scheduling",
    "web-search"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-chat-assistant",
      "driver": "eino",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "user-chat-with-assistant"
      },
      "parameters": {
        "models": {
          "eino-chat-assistant.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output and tool calls"
          }
        },
        "voices": {
          "eino-chat-assistant.assistant": {
            "role": "assistant",
            "language": "zh-CN",
            "description": "Assistant voice"
          }
        },
        "tools": {
          "web.search": {
            "tool_id": "volc-web-search",
            "description": "Volcengine web search; needs search_api_key in volc-credential"
          },
          "screen.get": {
            "source": "mhs",
            "description": "Read main screen settings; RuntimeProfile fixes the concrete instance"
          },
          "screen.brightness": {
            "source": "mhs",
            "description": "Write only supported brightness_percent on the Profile-bound main screen"
          },
          "light.get": {
            "source": "mhs",
            "description": "Read status light settings; RuntimeProfile fixes the concrete instance"
          },
          "light.brightness": {
            "source": "mhs",
            "description": "Write only supported brightness_percent on the Profile-bound status light"
          },
          "music.status": {
            "client_tool": "audioplayer.get",
            "description": "Read actual device playback state"
          },
          "music.playlist": {
            "client_tool": "audioplayer.playlist.get",
            "description": "Read existing songs and their zero-based indices"
          },
          "music.play": {
            "client_tool": "audioplayer.play",
            "description": "Play from the current device playlist"
          },
          "music.stop": {
            "client_tool": "audioplayer.stop",
            "description": "Stop device playback and retain its playlist"
          },
          "workflow.switch": {
            "client_tool": "run.workspace.set",
            "description": "Select a Profile Workflow alias; opening speech requires explicit user intent"
          }
        }
      }
    },
    "eino-function-chat": {
      "file": "eino.function-chat.yaml",
      "workflow_id": "eino-function-chat",
      "driver": "eino",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "user-chat-with-assistant"
      },
      "parameters": {
        "models": {
          "eino-function-chat.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Conversational lane; native tool calls must be disabled"
          },
          "eino-function-chat.intent": {
            "kind": "llm",
            "role": "controller",
            "description": "Parallel device intent lane; requires native tool calls"
          },
          "eino-function-chat.classify": {
            "kind": "llm",
            "role": "router",
            "description": "Tools-disabled routing and intent-completion labels; preserves pending intent until completion or cancellation"
          }
        },
        "voices": {
          "eino-function-chat.assistant": {
            "role": "assistant",
            "language": "zh-CN",
            "description": "One selected assistant reply voice"
          }
        },
        "tools": {
          "screen.get": {
            "source": "mhs",
            "description": "Read main screen settings; RuntimeProfile fixes the concrete instance"
          },
          "screen.brightness": {
            "source": "mhs",
            "description": "Write only supported brightness_percent on the Profile-bound main screen"
          },
          "light.get": {
            "source": "mhs",
            "description": "Read status light settings; RuntimeProfile fixes the concrete instance"
          },
          "light.brightness": {
            "source": "mhs",
            "description": "Write only supported brightness_percent on the Profile-bound status light"
          },
          "music.status": {
            "client_tool": "audioplayer.get",
            "description": "Read actual device playback state"
          },
          "music.playlist": {
            "client_tool": "audioplayer.playlist.get",
            "description": "Read existing songs and their zero-based indices"
          },
          "music.play": {
            "client_tool": "audioplayer.play",
            "description": "Play from the current device playlist"
          },
          "music.stop": {
            "client_tool": "audioplayer.stop",
            "description": "Stop device playback and retain its playlist"
          },
          "workflow.switch": {
            "client_tool": "run.workspace.set",
            "description": "Select a Profile Workflow alias; opening speech requires explicit user intent"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "chat-assistant-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "chat-assistant-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 12,
      "checkpoints": [
        "establish-trip",
        "establish-purpose",
        "correct-destination-train",
        "short-encouragement",
        "exact-answer",
        "challenge-stale-trip",
        "partial-recall",
        "correct-day-time",
        "unrelated-turn",
        "reload-recall",
        "compact-recall",
        "final-confirmation"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/smoke/chat-assistant.eino.giztest.yaml",
      "tier": "smoke",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/quality/chat-assistant.eino.giztest.yaml",
      "tier": "quality",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/soak/chat-assistant.eino.giztest.yaml",
      "tier": "soak",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/smoke/chat-assistant.eino.function-chat.giztest.yaml",
      "tier": "smoke",
      "implementations": [
        "eino-function-chat"
      ]
    },
    {
      "file": "tests/giztest/quality/chat-assistant.eino.function-chat.giztest.yaml",
      "tier": "quality",
      "implementations": [
        "eino-function-chat"
      ]
    },
    {
      "file": "tests/giztest/soak/chat-assistant.eino.function-chat.giztest.yaml",
      "tier": "soak",
      "implementations": [
        "eino-function-chat"
      ]
    }
  ]
}
