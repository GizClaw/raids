{
  "schema": "raids.raid/v1alpha1",
  "id": "story-robinson-crusoe",
  "category": "story",
  "title": {
    "zh-CN": "鲁滨逊漂流记",
    "en": "Robinson Crusoe"
  },
  "summary": {
    "zh-CN": "通过荒岛生活学习计划、制作、观察与求助。",
    "en": "Learn planning, making, observation, and seeking help through an island survival story."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "survival",
    "island",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-robinson-crusoe",
      "driver": "eino",
      "input": [
        "text"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-robinson-crusoe.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-robinson-crusoe",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-robinson-crusoe.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-robinson-crusoe.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-robinson-crusoe.robinson": {
            "role": "robinson",
            "language": "zh-CN",
            "description": "鲁滨逊 character voice"
          },
          "flowcraft-story-robinson-crusoe.friday": {
            "role": "friday",
            "language": "zh-CN",
            "description": "星期五 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-robinson-crusoe-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-robinson-crusoe-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "退潮物资",
        "荒岛营地",
        "陌生脚印",
        "共同归航"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-robinson-crusoe/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-robinson-crusoe/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-robinson-crusoe/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    }
  ]
}
