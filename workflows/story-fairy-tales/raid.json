      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-fairy-tales.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-fairy-tales.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-fairy-tales.heroine": {
            "role": "heroine",
            "language": "zh-CN",
            "description": "女主角 character voice"
          },
          "flowcraft-story-fairy-tales.companion": {
            "role": "companion",
            "language": "zh-CN",
            "description": "伙伴 character voice"
          }
        }
      }
    }
  },
