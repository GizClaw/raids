{
  "schema": "raids.raid/v1alpha1",
  "id": "adventure-desert-island",
  "category": "adventure",
  "title": {
    "zh-CN": "荒岛求生",
    "en": "Desert Island"
  },
  "summary": {
    "zh-CN": "在虚构荒岛中学习安全优先、求救和资源规划。",
    "en": "Learn safety priorities, rescue signaling, and resource planning on a fictional island."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "survival",
    "problem-solving"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-adventure-desert-island",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "eino-adventure-desert-island.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "eino-adventure-desert-island.adventure-guide": {
            "role": "adventure-guide",
            "language": "zh-CN",
            "description": "旁白 voice"
          },
          "eino-adventure-desert-island.scout": {
            "role": "scout",
            "language": "zh-CN",
            "description": "侦察伙伴 voice"
          },
          "eino-adventure-desert-island.signal-officer": {
            "role": "signal-officer",
            "language": "zh-CN",
            "description": "求救信号员 voice"
          },
          "eino-adventure-desert-island.safety-officer": {
            "role": "safety-officer",
            "language": "zh-CN",
            "description": "安全队员 voice"
          }
        }
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-adventure-desert-island",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "flowcraft-adventure-desert-island.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-adventure-desert-island.adventure-guide": {
            "role": "adventure-guide",
            "language": "zh-CN",
            "description": "旁白 voice"
          },
          "flowcraft-adventure-desert-island.scout": {
            "role": "scout",
            "language": "zh-CN",
            "description": "侦察伙伴 voice"
          },
          "flowcraft-adventure-desert-island.signal-officer": {
            "role": "signal-officer",
            "language": "zh-CN",
            "description": "求救信号员 voice"
          },
          "flowcraft-adventure-desert-island.safety-officer": {
            "role": "safety-officer",
            "language": "zh-CN",
            "description": "安全队员 voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "adventure-desert-island-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "adventure-desert-island-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 7,
      "checkpoints": [
        "opening",
        "english-opening",
        "continue-choice",
        "fact-boundary",
        "safety-boundary",
        "memory-store",
        "memory-recall"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/adventure-desert-island/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    },
    {
      "file": "tests/giztest/adventure-desert-island/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    },
    {
      "file": "tests/giztest/adventure-desert-island/eino.realtime.giztest.yaml",
      "implementation": "eino",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/adventure-desert-island/flowcraft.realtime.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/adventure-desert-island/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 4,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/adventure-desert-island/eino.roles.giztest.yaml",
      "implementation": "eino",
      "topology": "isolated-role-probes",
      "roles": 4,
      "requires_audio": true
    }
  ]
}
