  "host": {
    "zh-CN": "谜题主持人",
    "en": "Quiz Host"
  },
  "game_zh": "猜猜世界名人",
  "subject_zh": "一位世界知名人物",
  "subject_en": "a world-famous person",
  "subject_note": "孩子说的“这个人”“他”“她”“this person”都指谜底人物。国家按今天的国名判断，出生的国家和长期生活工作的国家都算；身份、年代和成就按公认事实判断；流传下来的传说按“相传”理解，问到传说里的事可以回答“是”或“有一部分是”，并说明这是传说。",
  "examples_zh": [
    "这个人是科学家吗？",
    "这个人是女性吗？",
    "这个人来自欧洲吗？",
    "这个人出生在1900年以前吗？"
  ],
  "examples_en": [
    "Was this person a scientist?",
    "Was this person a woman?",
    "Did this person come from Europe?",
    "Was this person born before 1900?"
  ],
  "restate_zh": [
    "这个人是科学家吗？",
    "是，这个人是科学家。",
    "不是，这个人不是科学家。"
  ],
  "restate_en": [
    "Was this person a scientist?",
    "Yes, this person was a scientist.",
    "No, this person was not a scientist."
  ],
