  "title": {
    "zh-CN": "猜猜世界名胜",
    "en": "Guess the World Landmark"
  },
  "summary": {
    "zh-CN": "主持人心里藏着一处世界名胜，可能是著名建筑，也可能是自然奇观，孩子用是非题来猜，猜中就升一关，从“环球小萌新”一路挑战到“世界奇观大师”。",
    "en": "The host hides a world-famous place, a landmark or a natural wonder; the child guesses with yes-or-no questions and levels up from Globe Rookie to Wonder Master."
  },
  "tags": [
    "guess",
    "landmarks",
    "geography",
    "world",
    "yes-no",
    "levels"
  ],
  "host": {
    "zh-CN": "谜题主持人",
    "en": "Quiz Host"
  },
  "game_zh": "猜猜世界名胜",
  "subject_zh": "一处世界名胜",
  "subject_en": "a world-famous place",
  "subject_note": "孩子说的“它”“这里”“这个地方”“this”“it”都指谜底这处名胜，按它的真实位置、是自然形成还是人造、属于什么类型和公认的特点来判断；横跨几个国家的，问到其中一个国家就回答“是”，并说明它不只在那里。",
  "examples_zh": [
    "它在亚洲吗？",
    "它是人造的吗？",
    "它是一座山吗？",
    "它和水有关吗？"
  ],
  "examples_en": [
    "Is it in Asia?",
    "Is it made by people?",
    "Is it a mountain?",
    "Does it have to do with water?"
  ],
  "restate_zh": [
    "它是人造的吗？",
    "是，它是人造的。",
    "不是，它不是人造的。"
  ],
  "restate_en": [
    "Is it made by people?",
    "Yes, it is made by people.",
    "No, it is not made by people."
  ],
