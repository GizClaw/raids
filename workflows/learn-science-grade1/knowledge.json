      "facts": [
        {
          "fact": "舌头能尝出甜、酸、苦、咸、鲜五种基本味道",
          "sources": [
            "https://www.smithsonianmag.com/science-nature/neat-and-tidy-map-tastes-tongue-you-learned-school-all-wrong-180963407/",
            "https://www.scientificamerican.com/article/bring-science-home-jelly-bean-taste-smell/"
          ]
        },
        {
          "fact": "绿色植物的叶子能借助阳光，用水和二氧化碳制造养分，还放出氧气",
          "sources": [
            "https://ib.cas.cn/2019gb/kepu/yuandi/201603/t20160330_4577151.html",
            "https://www.kepuchina.cn/article/articleinfo?business_type=100&ar_id=242187"
          ]
        },
        {
          "fact": "小向日葵会跟着太阳转头，长大开花后就一直朝着东方",
          "sources": [
            "https://www.ucdavis.edu/news/sunflowers-move-clock",
            "https://news.berkeley.edu/2016/08/04/how-sunflowers-follow-the-sun",
            "https://m.chinacrops.org/267/202405/4741.html"
          ]
        }
      ],
      "misconceptions": [
        {
          "wrong": "舌尖只能尝甜，舌根只能尝苦（“味觉地图”）",
          "right": "舌头上有味蕾的地方都能尝到各种味道，各处差别很小",
          "sources": [
            "https://www.kepuchina.cn/article/articleinfo?business_type=100&ar_id=514846",
            "https://www.smithsonianmag.com/science-nature/neat-and-tidy-map-tastes-tongue-you-learned-school-all-wrong-180963407/"
          ]
        },
        {
          "wrong": "植物不会走动，所以植物不是活的",
          "right": "植物也是生物，它会吸收水分和养料、会生长，还能长出种子",
