          "flowcraft-story-little-prince.little-prince": {
            "role": "little-prince",
            "language": "zh-CN",
            "description": "小王子 character voice"
          },
          "flowcraft-story-little-prince.rose": {
            "role": "rose",
            "language": "zh-CN",
            "description": "玫瑰 character voice"
          }
        }
      }
    }
