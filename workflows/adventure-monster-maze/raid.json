{
  "schema": "raids.raid/v1alpha1",
  "id": "adventure-monster-maze",
  "category": "adventure",
  "title": {
    "zh-CN": "怪兽迷宫",
    "en": "Monster Maze"
  },
  "summary": {
    "zh-CN": "用方向、图形和逻辑谜题走出不恐怖的怪兽迷宫。",
    "en": "Escape a friendly monster maze using direction, shape, and logic puzzles."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "maze",
    "spatial",
    "puzzle"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-adventure-monster-maze",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "eino-adventure-monster-maze.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "eino-adventure-monster-maze.adventure-guide": {
            "role": "adventure-guide",
