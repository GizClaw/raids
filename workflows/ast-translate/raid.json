{
  "schema": "raids.raid/v1alpha1",
  "id": "ast-translate",
  "category": "translate",
  "title": {
    "zh-CN": "同声传译",
    "en": "Simultaneous Interpretation"
  },
  "summary": {
    "zh-CN": "边听边译的语音同传：中文与英语、日语、韩语双向互译，也能把中文译成法语和西班牙语，译文用目标语言的音色播报。",
    "en": "Speech-to-speech interpretation between Chinese and English, Japanese, or Korean, plus Chinese into French and Spanish, voiced in the target language."
  },
  "rating": {
    "age": [
      "preschool",
      "child",
      "teen",
      "adult",
      "senior"
    ],
    "scheme": "raids-age-v2",
    "content": []
  },
  "tags": [
    "translation",
    "interpretation",
    "multilingual"
  ],
  "language": [
    "zh-CN",
    "en",
    "ja",
    "ko",
    "fr",
    "es"
  ],
  "implementations": {
    "zh-en-auto": {
      "file": "zh-en-auto.yaml",
      "workflow_id": "ast-translate-zh-en-auto",
      "driver": "ast-translate",
      "input": [
        "push-to-talk",
        "realtime"
      ],
      "parameters": {
        "models": {
          "ast-translate-zh-en-auto.model": {
            "kind": "translation",
            "role": "translator",
            "description": "Volc AST speech-to-speech translation model"
          }
        },
        "voices": {
          "ast-translate-zh-en-auto.translator": {
            "role": "translator",
