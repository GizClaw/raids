{
  "schema": "raids.raid/v1alpha1",
  "id": "adventure-history",
  "category": "adventure",
  "title": {
    "zh-CN": "历史穿梭",
    "en": "History Travel"
  },
  "summary": {
    "zh-CN": "作为时空观察员探索历史现场并理解因果。",
    "en": "Explore historical settings as a time observer and understand cause and effect."
  },
  "rating": {
    "age": "9+",
    "scheme": "raids-age-v1",
    "content": [

    ]
  },
  "tags": [
    "history",
    "time-travel",
    "facts"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-adventure-history",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "eino-adventure-history.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "eino-adventure-history.adventure-guide": {
            "role": "adventure-guide",
            "language": "zh-CN",
            "description": "旁白：连续剧本段落音色"
          },
          "eino-adventure-history.historian": {
            "role": "historian",
            "language": "zh-CN",
            "description": "历史讲解员：连续剧本段落音色"
          },
          "eino-adventure-history.artisan": {
            "role": "artisan",
            "language": "zh-CN",
            "description": "工匠：连续剧本段落音色"
          },
          "eino-adventure-history.market-guide": {
            "role": "market-guide",
            "language": "zh-CN",
            "description": "集市向导：连续剧本段落音色"
          }
        }
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-adventure-history",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "flowcraft-adventure-history.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-adventure-history.adventure-guide": {
            "role": "adventure-guide",
            "language": "zh-CN",
            "description": "旁白：连续剧本段落音色"
          },
          "flowcraft-adventure-history.historian": {
            "role": "historian",
            "language": "zh-CN",
            "description": "历史讲解员：连续剧本段落音色"
          },
          "flowcraft-adventure-history.artisan": {
            "role": "artisan",
            "language": "zh-CN",
            "description": "工匠：连续剧本段落音色"
          },
          "flowcraft-adventure-history.market-guide": {
            "role": "market-guide",
            "language": "zh-CN",
            "description": "集市向导：连续剧本段落音色"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "adventure-history-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "adventure-history-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 7,
      "checkpoints": [
        "opening",
        "english-opening",
        "continue-choice",
        "fact-boundary",
        "safety-boundary",
        "memory-store",
        "memory-recall"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/smoke/adventure-history.giztest.yaml",
      "tier": "smoke",
      "implementations": [
        "eino",
        "flowcraft"
      ]
    },
    {
      "file": "tests/giztest/quality/adventure-history.giztest.yaml",
