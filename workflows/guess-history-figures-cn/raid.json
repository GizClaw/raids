{
  "schema": "raids.raid/v1alpha1",
  "id": "guess-history-figures-cn",
  "category": "guess",
  "region": "cn",
  "title": {
    "zh-CN": "猜猜历史人物·中国",
    "en": "Guess the Figure: China"
  },
  "summary": {
    "zh-CN": "主持人心里藏着一位中国历史人物，孩子用是非题来猜，猜中就升一关，从“史海萌新”一路挑战到“千古通鉴”。",
    "en": "The host hides a figure from Chinese history; the child guesses with yes-or-no questions and levels up from History Rookie to Master of the Ages."
  },
  "rating": {
    "age": [
      "preschool",
      "child",
      "teen"
    ],
    "scheme": "raids-age-v2",
    "content": []
  },
  "tags": [
    "guess",
    "history",
    "figures",
    "china",
    "yes-no",
    "levels"
  ],
  "language": [
    "zh-CN",
    "en"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-guess-history-figures-cn",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "parameters": {
        "models": {
          "eino-guess-history-figures-cn.model": {
            "kind": "llm",
            "role": "host",
            "description": "Chat model that speaks every host turn from the nameless puzzle card; needs streaming Chinese and English output"
          }
        },
        "voices": {
          "eino-guess-history-figures-cn.host": {
            "role": "host",
            "language": "zh-CN",
            "description": "Quiz host voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "guess-history-figures-cn-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "guess-history-figures-cn-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 12,
      "checkpoints": [
        "opening",
        "yes-answer",
        "fact-before-qin",
        "fact-modern",
        "ask-answer",
        "big-hint",
        "no-answer",
        "win",
        "next-round",
        "english",
        "give-up",
        "resume"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/smoke/guess-history-figures-cn.eino.giztest.yaml",
      "tier": "smoke",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/quality/guess-history-figures-cn.eino.giztest.yaml",
      "tier": "quality",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/soak/guess-history-figures-cn.eino.giztest.yaml",
      "tier": "soak",
      "implementations": [
        "eino"
      ]
    }
  ]
}
