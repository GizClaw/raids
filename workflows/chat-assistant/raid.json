{
  "schema": "raids.raid/v1alpha1",
  "id": "chat-assistant",
  "category": "assistant",
  "title": {
    "zh-CN": "聊天助手",
    "en": "Chat Assistant"
  },
  "summary": {},
  "rating": {
    "age": [
      "preschool",
      "child",
      "teen",
      "adult",
      "senior"
    ],
    "scheme": "raids-age-v2",
    "content": []
  },
  "tags": [
    "assistant",
    "memory",
    "scheduling",
    "web-search"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-chat-assistant",
      "driver": "eino",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "user-chat-with-assistant"
      },
      "parameters": {
        "models": {
          "eino-chat-assistant.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output and tool calls"
          }
        },
        "voices": {
          "eino-chat-assistant.assistant": {
            "role": "assistant",
            "language": "zh-CN",
            "description": "Assistant voice"
          }
        },
        "tools": {
          "web-search": {
            "tool_id": "volc-web-search",
            "description": "Volcengine web search; needs search_api_key in volc-credential"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "chat-assistant-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "chat-assistant-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 12,
      "checkpoints": [
        "establish-trip",
        "establish-purpose",
        "correct-destination-train",
        "short-encouragement",
        "exact-answer",
        "challenge-stale-trip",
        "partial-recall",
        "correct-day-time",
        "unrelated-turn",
        "reload-recall",
        "compact-recall",
        "final-confirmation"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/smoke/chat-assistant.eino.giztest.yaml",
      "tier": "smoke",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/quality/chat-assistant.eino.giztest.yaml",
      "tier": "quality",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/soak/chat-assistant.eino.giztest.yaml",
      "tier": "soak",
      "implementations": [
        "eino"
      ]
    }
  ]
}
