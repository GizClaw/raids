{
  "schema": "raids.raid/v1alpha1",
  "id": "story-tom-sawyer",
  "category": "story",
  "title": {
    "zh-CN": "汤姆索亚历险记",
    "en": "The Adventures of Tom Sawyer"
  },
  "summary": {
    "zh-CN": "通过童年冒险讨论好奇心、诚实、友谊与后果。",
    "en": "Explore curiosity, honesty, friendship, and consequences through a childhood adventure."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "childhood",
    "adventure",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-tom-sawyer",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-tom-sawyer.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-tom-sawyer",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-tom-sawyer.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-tom-sawyer.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-tom-sawyer.tom": {
            "role": "tom",
            "language": "zh-CN",
            "description": "汤姆 character voice"
          },
          "flowcraft-story-tom-sawyer.becky": {
            "role": "becky",
            "language": "zh-CN",
            "description": "贝琪 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-tom-sawyer-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-tom-sawyer-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "河边地图",
        "承诺冲突",
        "洞穴线索",
        "诚实归来"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-tom-sawyer/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-tom-sawyer/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-tom-sawyer/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-tom-sawyer/eino.realtime.giztest.yaml",
      "implementation": "eino",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-tom-sawyer/flowcraft.realtime.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    }
  ]
}
