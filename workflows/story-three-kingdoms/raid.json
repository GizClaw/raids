{
  "schema": "raids.raid/v1alpha1",
  "id": "story-three-kingdoms",
  "category": "story",
  "title": {
    "zh-CN": "三国乱世",
    "en": "Legends of the Three Kingdoms"
  },
  "summary": {
    "zh-CN": "从三国人物与谋略中体验选择、合作和责任。",
    "en": "Explore choices, cooperation, and responsibility through Three Kingdoms characters and strategy."
  },
  "rating": {
    "age": "9+",
    "scheme": "raids-age-v1",
    "content": [
      "historical-war"
    ]
  },
  "tags": [
    "chinese-history",
    "strategy",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-three-kingdoms",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-three-kingdoms.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-three-kingdoms",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-three-kingdoms.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-three-kingdoms.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-three-kingdoms.liu-bei": {
            "role": "liu-bei",
            "language": "zh-CN",
            "description": "刘备 character voice"
          },
          "flowcraft-story-three-kingdoms.zhuge-liang": {
            "role": "zhuge-liang",
            "language": "zh-CN",
            "description": "诸葛亮 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-three-kingdoms-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-three-kingdoms-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "营帐军情",
        "百姓与追击",
        "联盟试探",
        "责任定策"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-three-kingdoms/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-three-kingdoms/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-three-kingdoms/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-three-kingdoms/eino.realtime.giztest.yaml",
      "implementation": "eino",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-three-kingdoms/flowcraft.realtime.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    }
  ]
}
