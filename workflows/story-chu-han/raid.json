{
  "schema": "raids.raid/v1alpha1",
  "id": "story-chu-han",
  "category": "story",
  "title": {
    "zh-CN": "楚汉风云",
    "en": "Chu-Han Contention"
  },
  "summary": {
    "zh-CN": "在楚汉故事中理解领导、承诺、判断与团队合作。",
    "en": "Explore leadership, promises, judgment, and teamwork through Chu-Han stories."
  },
  "rating": {
    "age": "9+",
    "scheme": "raids-age-v1",
    "content": [
      "historical-war"
    ]
  },
  "tags": [
    "chinese-history",
    "strategy",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-chu-han",
      "driver": "eino",
      "input": [
        "text"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-chu-han.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-chu-han",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-chu-han.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-chu-han.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-chu-han.xiang-yu": {
            "role": "xiang-yu",
            "language": "zh-CN",
            "description": "项羽 character voice"
          },
          "flowcraft-story-chu-han.empress-lu": {
            "role": "empress-lu",
            "language": "zh-CN",
            "description": "吕后 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-chu-han-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-chu-han-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "承诺与力量",
        "鸿沟抉择",
        "人心转折",
        "责任回响"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-chu-han/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-chu-han/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-chu-han/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-chu-han/eino.realtime.giztest.yaml",
      "implementation": "eino",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-chu-han/flowcraft.realtime.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    }
  ]
}
