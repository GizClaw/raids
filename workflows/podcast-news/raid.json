{
  "schema": "raids.raid/v1alpha1",
  "id": "podcast-news",
  "category": "podcast",
  "title": {
    "zh-CN": "新闻播客",
    "en": "News Podcast"
  },
  "summary": {
    "zh-CN": "选择新闻领域后，持续搜索最新资讯，以事实为主播报，随时暂停或换话题。",
    "en": "Search fresh news every generation and report sourced facts continuously."
  },
  "rating": {
    "age": [
      "teen",
      "adult",
      "senior"
    ],
    "scheme": "raids-age-v2",
    "content": []
  },
  "tags": [
    "podcast",
    "continuous",
    "news",
    "web-search"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-podcast-news",
      "driver": "eino",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "parameters": {
        "models": {
          "eino-podcast-news.model": {
            "kind": "llm",
            "role": "host",
            "description": "Streaming Chinese narration with native search Tool calls"
          }
        },
        "voices": {
          "eino-podcast-news.host": {
            "role": "host",
            "language": "zh-CN",
            "description": "Podcast host voice"
          }
        },
        "tools": {
          "web.search": {
            "tool_id": "volc-web-search",
            "description": "Doubao Search Custom API for fresh news"
          }
        }
      }
    }
  },
  "tests": [
    {
      "file": "tests/giztest/smoke/podcast-news.eino.giztest.yaml",
      "tier": "smoke",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/quality/podcast-news.eino.giztest.yaml",
      "tier": "quality",
      "implementations": [
        "eino"
      ]
    },
    {
      "file": "tests/giztest/soak/podcast-news.eino.giztest.yaml",
      "tier": "soak",
      "implementations": [
        "eino"
      ]
    }
  ]
}
