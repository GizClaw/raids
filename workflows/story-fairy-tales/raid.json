{
  "schema": "raids.raid/v1alpha1",
  "id": "story-fairy-tales",
  "category": "story",
  "title": {
    "zh-CN": "童话故事",
    "en": "Fairy Tales"
  },
  "summary": {
    "zh-CN": "共同创造温暖、奇妙并能由孩子选择方向的童话。",
    "en": "Co-create warm and imaginative fairy tales whose direction the child can choose."
  },
  "rating": {
    "age": "3+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "fairy-tale",
    "classic",
    "bedtime"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-fairy-tales",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-fairy-tales.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-fairy-tales",
