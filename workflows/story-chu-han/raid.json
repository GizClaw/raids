{
  "schema": "raids.raid/v1alpha1",
  "id": "story-chu-han",
  "category": "story",
  "title": {
    "zh-CN": "楚汉风云",
    "en": "Chu-Han Contention"
  },
  "summary": {
    "zh-CN": "在楚汉故事中理解领导、承诺、判断与团队合作。",
    "en": "Explore leadership, promises, judgment, and teamwork through Chu-Han stories."
  },
  "rating": {
    "age": "9+",
    "scheme": "raids-age-v1",
    "content": [
      "historical-war"
    ]
  },
  "tags": [
    "chinese-history",
    "strategy",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-chu-han",
      "driver": "eino",
      "input": [
        "text"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-chu-han.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-chu-han",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-chu-han.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-chu-han.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-chu-han-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-chu-han-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 7,
      "checkpoints": [
        "opening",
        "english-opening",
        "continue-choice",
        "fact-boundary",
        "safety-boundary",
        "memory-store",
        "memory-recall"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-chu-han/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    },
    {
      "file": "tests/giztest/story-chu-han/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    }
  ]
}
