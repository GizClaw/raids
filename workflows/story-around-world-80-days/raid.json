{
  "schema": "raids.raid/v1alpha1",
  "id": "story-around-world-80-days",
  "category": "story",
  "title": {
    "zh-CN": "环游地球八十天",
    "en": "Around the World in Eighty Days"
  },
  "summary": {
    "zh-CN": "用路线、时区和交通选择完成环球旅行挑战。",
    "en": "Complete a world journey through route, time-zone, and transport choices."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "travel",
    "geography",
    "classic",
    "verne"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-around-world-80-days",
      "driver": "eino",
      "input": [
        "text"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-around-world-80-days.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-around-world-80-days",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-around-world-80-days.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-around-world-80-days.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-around-world-80-days.fogg": {
            "role": "fogg",
            "language": "zh-CN",
            "description": "福格 character voice"
          },
          "flowcraft-story-around-world-80-days.aouda": {
            "role": "aouda",
            "language": "zh-CN",
            "description": "艾娥达 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-around-world-80-days-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-around-world-80-days-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "伦敦启程",
        "时区追逐",
        "风暴改道",
        "归期谜底"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-around-world-80-days/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-around-world-80-days/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-around-world-80-days/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    }
  ]
}
