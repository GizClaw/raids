  "tester": {
    "file": "test.yaml",
    "workflow_id": "adventure-treasure-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "adventure-treasure-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 7,
      "checkpoints": [
        "opening",
        "english-opening",
        "continue-choice",
        "fact-boundary",
        "safety-boundary",
        "memory-store",
        "memory-recall"
