# Environment example maintenance guide:
# - Keep variable names exactly aligned with the environment-variable placeholders
#   used by Credential and Tenant resources in credentials/ and tenants/.
# - Add, rename, or remove a variable whenever a resource placeholder changes.
# - Keep every value empty in this file; real credentials and account configuration
#   belong in the consuming product or deployment environment.
# - Never commit a populated copy of this file or any real secret.

# OpenAI
GIZCLAW_OPENAI_API_KEY=

# Volcengine / Doubao
GIZCLAW_VOLC_SPEECH_APP_ID=
GIZCLAW_VOLC_SPEECH_API_KEY=
GIZCLAW_VOLC_ARK_API_KEY=
GIZCLAW_VOLC_SEARCH_API_KEY=
GIZCLAW_VOLC_OPENAPI_ACCESS_KEY_ID=
GIZCLAW_VOLC_OPENAPI_ACCESS_KEY=

# MiniMax CN
GIZCLAW_MINIMAX_CN_API_KEY=
GIZCLAW_MINIMAX_CN_GROUP_ID=

# MiniMax Global
GIZCLAW_MINIMAX_GLOBAL_API_KEY=
GIZCLAW_MINIMAX_GLOBAL_GROUP_ID=

# Google Gemini
GIZCLAW_GEMINI_API_KEY=

# Alibaba Cloud DashScope / Qwen
GIZCLAW_QWEN_DASHSCOPE_API_KEY=

# DeepSeek
GIZCLAW_DEEPSEEK_API_KEY=
