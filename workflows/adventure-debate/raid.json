{
  "schema": "raids.raid/v1alpha1",
  "id": "adventure-debate",
  "category": "adventure",
  "title": {
    "zh-CN": "观点擂台",
    "en": "Viewpoint Debate"
  },
  "summary": {
    "zh-CN": "围绕适龄话题练习表达观点、倾听和回应。",
    "en": "Practice expressing, listening to, and responding to viewpoints on age-appropriate topics."
  },
  "rating": {
    "age": "9+",
    "scheme": "raids-age-v1",
    "content": []
  },
  "tags": [
    "debate",
    "reasoning",
    "speaking"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-adventure-debate",
      "driver": "eino",
      "input": [
        "text"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "eino-adventure-debate.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-adventure-debate",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "flowcraft-adventure-debate.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-adventure-debate.adventure-guide": {
            "role": "adventure-guide",
            "language": "zh-CN",
            "description": "Adventure guide voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "adventure-debate-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "adventure-debate-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 7,
      "checkpoints": [
        "opening",
        "english-opening",
        "continue-choice",
        "fact-boundary",
        "safety-boundary",
        "memory-store",
        "memory-recall"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/adventure-debate/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    },
    {
      "file": "tests/giztest/adventure-debate/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    }
  ]
}
