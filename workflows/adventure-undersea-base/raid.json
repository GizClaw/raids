{
  "schema": "raids.raid/v1alpha1",
  "id": "adventure-undersea-base",
  "category": "adventure",
  "title": {
    "zh-CN": "海底基地",
    "en": "Undersea Base"
  },
  "summary": {
    "zh-CN": "管理海底科研基地并探索海洋生态。",
    "en": "Manage an undersea research base while exploring ocean ecosystems."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "ocean",
    "science",
    "exploration"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-adventure-undersea-base",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "eino-adventure-undersea-base.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "eino-adventure-undersea-base.adventure-guide": {
            "role": "adventure-guide",
            "language": "zh-CN",
            "description": "旁白 voice"
          },
          "eino-adventure-undersea-base.biologist": {
            "role": "biologist",
            "language": "zh-CN",
            "description": "海洋生物学家 voice"
          },
          "eino-adventure-undersea-base.engineer": {
            "role": "engineer",
            "language": "zh-CN",
            "description": "基地工程师 voice"
          },
          "eino-adventure-undersea-base.diver": {
            "role": "diver",
            "language": "zh-CN",
            "description": "潜航员 voice"
          }
        }
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-adventure-undersea-base",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "flowcraft-adventure-undersea-base.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-adventure-undersea-base.adventure-guide": {
            "role": "adventure-guide",
            "language": "zh-CN",
            "description": "旁白 voice"
          },
          "flowcraft-adventure-undersea-base.biologist": {
            "role": "biologist",
            "language": "zh-CN",
            "description": "海洋生物学家 voice"
          },
          "flowcraft-adventure-undersea-base.engineer": {
            "role": "engineer",
            "language": "zh-CN",
            "description": "基地工程师 voice"
          },
          "flowcraft-adventure-undersea-base.diver": {
            "role": "diver",
            "language": "zh-CN",
            "description": "潜航员 voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "adventure-undersea-base-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "adventure-undersea-base-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 7,
      "checkpoints": [
        "opening",
        "english-opening",
        "continue-choice",
        "fact-boundary",
        "safety-boundary",
        "memory-store",
        "memory-recall"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/adventure-undersea-base/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    },
    {
      "file": "tests/giztest/adventure-undersea-base/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "reload": true,
      "timeout": "35m"
    },
    {
      "file": "tests/giztest/adventure-undersea-base/eino.realtime.giztest.yaml",
      "implementation": "eino",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/adventure-undersea-base/flowcraft.realtime.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/adventure-undersea-base/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 4,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/adventure-undersea-base/eino.roles.giztest.yaml",
      "implementation": "eino",
      "topology": "isolated-role-probes",
      "roles": 4,
      "requires_audio": true
    }
  ]
}
