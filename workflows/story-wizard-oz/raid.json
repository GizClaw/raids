{
  "schema": "raids.raid/v1alpha1",
  "id": "story-wizard-oz",
  "category": "story",
  "title": {
    "zh-CN": "绿野仙踪",
    "en": "The Wizard of Oz"
  },
  "summary": {
    "zh-CN": "在奥兹旅途中发现勇气、智慧、善意与伙伴关系。",
    "en": "Discover courage, wisdom, kindness, and friendship on a journey through Oz."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "fantasy",
    "friendship",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-wizard-oz",
      "driver": "eino",
      "input": [
        "text"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-wizard-oz.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-wizard-oz",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-wizard-oz.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-wizard-oz.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-wizard-oz.dorothy": {
            "role": "dorothy",
            "language": "zh-CN",
            "description": "多萝西 character voice"
          },
          "flowcraft-story-wizard-oz.scarecrow": {
            "role": "scarecrow",
            "language": "zh-CN",
            "description": "稻草人 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-wizard-oz-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-wizard-oz-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "黄砖岔路",
        "勇气考验",
        "智慧迷城",
        "伙伴归途"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-wizard-oz/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-wizard-oz/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-wizard-oz/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-wizard-oz/english-restart.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-language-restart",
      "language": "en"
    },
    {
      "file": "tests/giztest/story-wizard-oz/english-restart.eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay-language-restart",
      "responses": 4,
      "language": "en"
    },
    {
      "file": "tests/giztest/story-wizard-oz/eino.realtime.giztest.yaml",
      "implementation": "eino",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-wizard-oz/flowcraft.realtime.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    }
  ]
}
