{
  "schema": "raids.raid/v1alpha1",
  "id": "story-aesop",
  "category": "story",
  "title": {
    "zh-CN": "伊索寓言",
    "en": "Aesop's Fables"
  },
  "summary": {
    "zh-CN": "通过简短动物寓言发现选择带来的结果与启发。",
    "en": "Discover consequences and lessons through short interactive animal fables."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "fable",
    "animals",
    "choices",
    "cooperation",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-aesop",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-aesop.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-aesop",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-aesop.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-aesop.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-aesop.tortoise": {
            "role": "tortoise",
            "language": "zh-CN",
            "description": "乌龟 character voice"
          },
          "flowcraft-story-aesop.bird": {
            "role": "bird",
            "language": "zh-CN",
            "description": "小鸟 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-aesop-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-aesop-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "种子的选择",
        "等待与分歧",
        "合作照料",
        "双重启发"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-aesop/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-aesop/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-aesop/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-aesop/flowcraft.transitions.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "stateful-transition-contract",
      "responses": 6,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-aesop/eino.realtime.giztest.yaml",
      "implementation": "eino",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-aesop/flowcraft.realtime.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    }
  ]
}
