{
  "schema": "raids.raid/v1alpha1",
  "id": "story-journey-center-earth",
  "category": "story",
  "title": {
    "zh-CN": "地心游记",
    "en": "Journey to the Center of the Earth"
  },
  "summary": {
    "zh-CN": "在地下幻想旅程中认识岩石、地层与地球科学。",
    "en": "Explore rocks, strata, and Earth science through a fictional underground journey."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "science",
    "exploration",
    "verne",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-journey-center-earth",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-journey-center-earth.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-journey-center-earth",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-journey-center-earth.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-journey-center-earth.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-journey-center-earth.axel": {
            "role": "axel",
            "language": "zh-CN",
            "description": "阿克塞尔 character voice"
          },
          "flowcraft-story-journey-center-earth.lidenbrock": {
            "role": "lidenbrock",
            "language": "zh-CN",
            "description": "黎登布洛克 character voice"
          }
        }
      }
    }
  },
  "tester": {
