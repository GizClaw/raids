{
  "schema": "raids.raid/v1alpha1",
  "id": "adventure-undersea-base",
  "category": "adventure",
  "title": {
    "zh-CN": "海底基地",
    "en": "Undersea Base"
  },
  "summary": {
    "zh-CN": "管理海底科研基地并探索海洋生态。",
    "en": "Manage an undersea research base while exploring ocean ecosystems."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "ocean",
    "science",
    "exploration"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-adventure-undersea-base",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "adventure"
      },
      "parameters": {
        "models": {
          "eino-adventure-undersea-base.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "eino-adventure-undersea-base.adventure-guide": {
            "role": "adventure-guide",
            "language": "zh-CN",
            "description": "Adventure guide voice"
          }
        }
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-adventure-undersea-base",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "adventure"
      },
