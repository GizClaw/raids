  "game_zh": "猜猜历史人物",
  "subject_zh": "一位中国历史人物",
  "subject_en": "a famous figure from Chinese history",
  "subject_note": "孩子说的“这个人”“他”“她”“this person”都指谜底人物。朝代、身份、成就按公认史实判断；流传下来的传说按“相传”理解，问到传说里的事可以回答“是”或“有一部分是”，并说明这是传说。",
  "examples_zh": [
    "这个人是皇帝吗？",
    "这个人是诗人吗？",
    "这个人生活在唐朝以前吗？",
    "这个人是女性吗？"
  ],
  "examples_en": [
    "Was this person an emperor?",
    "Was this person a poet?",
    "Did this person live before the Tang dynasty?",
    "Was this person a woman?"
  ],
  "restate_zh": [
    "这个人是诗人吗？",
    "是，这个人是诗人。",
    "不是，这个人不是诗人。"
  ],
  "restate_en": [
    "Was this person a poet?",
    "Yes, this person was a poet.",
    "No, this person was not a poet."
  ],
