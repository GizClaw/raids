{
  "schema": "raids.raid/v1alpha1",
  "id": "figure-galileo",
  "category": "figure",
  "title": {
    "zh-CN": "伽利略的一生",
    "en": "A Life with Galileo Galilei"
  },
  "summary": {
    "zh-CN": "由伽利略本人带孩子走完他的一生，从斜面上的小球一直讲到望远镜里的星空，并分清史实、传说与改编。",
    "en": "Walk through the life of Galileo Galilei with the scientist himself, telling history, legend, and adaptation apart."
  },
  "rating": {
    "age": [
      "child",
      "teen"
    ],
    "scheme": "raids-age-v2",
    "content": [
      "historical-hardship"
    ]
  },
  "tags": [
    "historical-figure",
    "astronomy",
    "biography"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino-multi-role": {
