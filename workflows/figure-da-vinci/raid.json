    "age": [
      "child",
      "teen"
    ],
    "scheme": "raids-age-v2",
    "content": [
      "historical-hardship"
    ]
  },
  "tags": [
    "historical-figure",
    "renaissance-art",
    "biography"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
