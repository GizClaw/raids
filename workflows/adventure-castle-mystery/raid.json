    "age": "9+",
    "scheme": "raids-age-v1",
    "content": [
      "mystery"
    ]
  },
  "tags": [
    "mystery",
    "deduction",
    "evidence"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
