  "host": {
    "zh-CN": "谜题主持人",
    "en": "Quiz Host"
  },
  "game_zh": "猜猜成语故事",
  "subject_zh": "一个成语故事",
  "subject_en": "a Chinese idiom story",
  "subject_note": "孩子说的“它”“这个成语”“这个故事”“this”“it”都指谜底成语和它背后的故事；按谜底卡上的意思、出处类型、故事主角和故事内容来判断，故事里真正出现的人、动物和东西才算“故事里有”，只在比方里提到的不算，褒贬和用法按今天的常见用法回答。",
  "examples_zh": [
    "它的故事里有动物吗？",
    "它是一个寓言故事吗？",
    "它是褒义词吗？",
    "它的故事主角是小孩吗？"
  ],
  "examples_en": [
    "Is there an animal in its story?",
    "Is it a fable?",
    "Does it have a positive meaning?",
    "Is the main character in its story a child?"
  ],
  "restate_zh": [
    "它的故事里有动物吗？",
    "是，它的故事里有动物。",
    "不是，它的故事里没有动物。"
  ],
  "restate_en": [
    "Is there an animal in its story?",
    "Yes, there is an animal in its story.",
    "No, there is no animal in its story."
  ],
