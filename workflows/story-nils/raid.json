{
  "schema": "raids.raid/v1alpha1",
  "id": "story-nils",
  "category": "story",
  "title": {
    "zh-CN": "尼尔斯骑鹅旅行记",
    "en": "The Wonderful Adventures of Nils"
  },
  "summary": {
    "zh-CN": "跟随候鸟旅行，认识地理、生态和尊重生命。",
    "en": "Travel with migratory birds to learn geography, ecology, and respect for life."
  },
  "rating": {
    "age": "6+",
    "scheme": "raids-age-v1",
    "content": [
      "mild-peril"
    ]
  },
  "tags": [
    "animals",
    "travel",
    "nordic",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-nils",
      "driver": "eino",
      "input": [
        "text",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-nils.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-nils",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk",
        "realtime"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-nils.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-nils.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-nils.nils": {
            "role": "nils",
            "language": "zh-CN",
            "description": "尼尔斯 character voice"
          },
          "flowcraft-story-nils.akka": {
            "role": "akka",
            "language": "zh-CN",
            "description": "阿卡 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-nils-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-nils-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "湿地风向",
        "雁群协作",
        "北方风暴",
        "归乡选择"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-nils/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-nils/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-nils/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-nils/eino.realtime.giztest.yaml",
      "implementation": "eino",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    },
    {
      "file": "tests/giztest/story-nils/flowcraft.realtime.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "realtime-roundtrip",
      "reload": true,
      "requires_audio": true
    }
  ]
}
