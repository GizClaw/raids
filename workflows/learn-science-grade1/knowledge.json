      "experiments": [
        {
          "title": "纸巾上的小豆芽",
          "goal": "看看种子发芽是不是需要水",
          "materials": [
            "绿豆或黄豆若干粒",
            "两个盘子",
            "纸巾",
            "清水"
          ],
          "steps": [
            "两个盘子都铺上纸巾，各放几粒豆子",
            "一个盘子把纸巾浇湿，另一个保持干燥",
            "放在屋里温暖的地方，湿盘每天补点水",
            "每天看一看，比一比两个盘子"
          ],
          "observe": "湿纸巾上的豆子会慢慢胀大、冒出小芽；干纸巾上的豆子没什么变化",
          "explain": "种子发芽需要水、空气和合适的温度，缺了水就不会发芽",
          "safety": "豆子不能放进嘴里、鼻子里或耳朵里；做完实验要洗手",
          "sources": [
            "https://web.extension.illinois.edu/gpe/case3/c3facts3.html",
            "https://extension.wvu.edu/lawn-gardening-pests/news/2021/02/01/germinating-seeds",
            "https://zzny.zhengzhou.gov.cn/njtg/6915741.jhtml"
          ]
        },
        {
          "title": "捏住鼻子猜味道",
          "goal": "发现鼻子也在帮我们“尝”味道",
          "materials": [
            "两种不同口味的果汁或软糖（大人准备）",
            "小杯子或小勺"
          ],
          "steps": [
            "闭上眼睛，用手捏住鼻子",
            "请大人喂你一小口，猜猜是什么口味",
            "松开鼻子，再尝一口同样的东西",
            "比一比：哪一次更容易猜对"
          ],
          "observe": "捏住鼻子时只觉得甜，很难分清口味；松开鼻子后一下就能尝出来",
          "explain": "食物的风味很大一部分靠鼻子闻，捏住鼻子气味进不去，就难分辨",
          "safety": "只吃大人准备好的食物，小口慢慢吃；对某种食物过敏就不要用它",
          "sources": [
            "https://www.scientificamerican.com/article/bring-science-home-jelly-bean-taste-smell/",
            "https://www.ninds.nih.gov/sites/default/files/documents/NINDS_The-Jelly-Bean-Test_Science-Activity-Guide_508C.pdf",
            "https://www.kepuchina.cn/article/articleinfo?business_type=100&classify=0&ar_id=655478"
          ]
        }
