  "title": {
    "zh-CN": "猜猜动物",
    "en": "Guess the Animal"
  },
  "summary": {
    "zh-CN": "主持人心里藏着一种动物，孩子用是非题来猜，猜中就升一关，从“动物小萌新”一路挑战到“百兽之王”。",
    "en": "The host hides an animal from anywhere in the world; the child guesses with yes-or-no questions and levels up from Animal Newbie to King of the Beasts."
  },
  "tags": [
    "guess",
    "animals",
    "nature",
    "science",
    "yes-no",
    "levels"
  ],
  "host": {
    "zh-CN": "谜题主持人",
    "en": "Quiz Host"
  },
  "game_zh": "猜猜动物",
  "subject_zh": "一种动物",
  "subject_en": "an animal",
  "subject_note": "孩子说的“它”“这个动物”“this”“it”都指谜底动物。按这种动物真实的样子、生活地区、食物、大小和本领来判断，以谜底卡为准；种类很多的动物按大多数种类回答，有明显例外就说“有一部分是”；已经灭绝的动物按它活着时的样子回答。",
  "examples_zh": [
    "它是哺乳动物吗？",
    "它会飞吗？",
    "它生活在水里吗？",
    "它比猫大吗？"
  ],
  "examples_en": [
    "Is it a mammal?",
    "Can it fly?",
    "Does it live in water?",
    "Is it bigger than a cat?"
  ],
  "restate_zh": [
    "它会游泳吗？",
    "是，它会游泳。",
    "不是，它不会游泳。"
  ],
  "restate_en": [
    "Can it swim?",
    "Yes, it can swim.",
    "No, it cannot swim."
  ],
