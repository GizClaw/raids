{
  "schema": "raids.raid/v1alpha1",
  "id": "story-fengshen",
  "category": "story",
  "title": {
    "zh-CN": "封神榜",
    "en": "Investiture of the Gods"
  },
  "summary": {
    "zh-CN": "讲述封神世界中的人物选择、法宝与正邪责任。",
    "en": "Tell child-friendly stories about choices, magical artifacts, duty, and justice in Investiture of the Gods."
  },
  "rating": {
    "age": "9+",
    "scheme": "raids-age-v1",
    "content": [
      "mythology",
      "mild-peril"
    ]
  },
  "tags": [
    "chinese-mythology",
    "legend",
    "classic"
  ],
  "language": [
    "zh-CN"
  ],
  "implementations": {
    "eino": {
      "file": "eino.yaml",
      "workflow_id": "eino-story-fengshen",
      "driver": "eino",
      "input": [
        "text"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "eino-story-fengshen.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {}
      }
    },
    "flowcraft": {
      "file": "flowcraft.yaml",
      "workflow_id": "flowcraft-story-fengshen",
      "driver": "flowcraft",
      "input": [
        "text",
        "push-to-talk"
      ],
      "memory": {
        "layout_id": "story-teller"
      },
      "parameters": {
        "models": {
          "flowcraft-story-fengshen.model": {
            "kind": "llm",
            "role": "narrator",
            "description": "Chat model that generates every turn; needs streaming Chinese output"
          }
        },
        "voices": {
          "flowcraft-story-fengshen.storyteller": {
            "role": "storyteller",
            "language": "zh-CN",
            "description": "Storyteller voice"
          },
          "flowcraft-story-fengshen.nezha": {
            "role": "nezha",
            "language": "zh-CN",
            "description": "哪吒 character voice"
          },
          "flowcraft-story-fengshen.jiang-ziya": {
            "role": "jiang-ziya",
            "language": "zh-CN",
            "description": "姜子牙 character voice"
          }
        }
      }
    }
  },
  "tester": {
    "file": "test.yaml",
    "workflow_id": "story-fengshen-test",
    "driver": "eino",
    "parameters": {
      "models": {
        "story-fengshen-test.model": {
          "kind": "llm",
          "role": "judge",
          "description": "Chat model that generates every turn; needs streaming Chinese output"
        }
      }
    },
    "route": {
      "responses": 16,
      "checkpoints": [
        "response-1",
        "response-2",
        "response-3",
        "response-4",
        "response-5",
        "response-6",
        "response-7",
        "response-8",
        "response-9",
        "response-10",
        "response-11",
        "response-12",
        "response-13",
        "response-14",
        "response-15",
        "response-16"
      ],
      "milestones": [
        8,
        16
      ],
      "reload_before": 9,
      "chapters": [
        "法宝择主",
        "责任试炼",
        "盟友分歧",
        "封神新约"
      ]
    }
  },
  "tests": [
    {
      "file": "tests/giztest/story-fengshen/eino.giztest.yaml",
      "implementation": "eino",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-fengshen/flowcraft.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "relay",
      "responses": 16,
      "reload": true
    },
    {
      "file": "tests/giztest/story-fengshen/flowcraft.roles.giztest.yaml",
      "implementation": "flowcraft",
      "topology": "isolated-role-probes",
      "roles": 3,
      "requires_audio": true
    }
  ]
}
